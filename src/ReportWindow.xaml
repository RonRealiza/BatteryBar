<Window x:Class="BatteryBar.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="BatteryBar — устройство не определилось"
        Icon="pack://application:,,,/assets/BatteryBar.ico"
        Width="640" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="32,24,32,28">
        <TextBlock Text="Устройство не определилось?" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" FontSize="13"
                   Text="Выберите устройство — по отчёту о нём можно будет добавить поддержку. Перед отправкой виден весь текст." />

        <TextBlock Style="{StaticResource Label}" Text="Устройство" />
        <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Stretch" IsEnabled="False"
                  SelectionChanged="DeviceCombo_SelectionChanged" />
        <TextBlock x:Name="ComboHint" Style="{StaticResource Secondary}" Margin="2,4,0,0" Text="Ищем подключённые устройства…" />

        <!-- Остальное появляется после выбора устройства. -->
        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="Модель" />
            <TextBox x:Name="ModelBox" TextChanged="Input_Changed" />
            <TextBlock Style="{StaticResource Secondary}" Margin="2,4,0,0" Text="Например, «Razer Viper V2 Pro» или «Attack Shark X3»" />

            <TextBlock Style="{StaticResource Label}" Text="Подробности" />
            <TextBox x:Name="CommentBox" TextChanged="Input_Changed" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />
            <TextBlock Style="{StaticResource Secondary}" Margin="2,4,0,0"
                       Text="Как подключено (ресивер, Bluetooth, провод), показывает ли заряд фирменная программа производителя" />

            <TextBlock Style="{StaticResource Label}" Text="Что будет отправлено" />
            <TextBox x:Name="PreviewBox" Height="200" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="Скопировать отчёт" MinWidth="150" Margin="0,0,8,0" Click="Copy_Click" />
                <Button x:Name="SendButton" Grid.Column="2" Content="Отправить на GitHub" MinWidth="170" Click="Send_Click"
                        Style="{DynamicResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
