<Window x:Class="BatteryBar.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BatteryBar"
        x:ClassModifier="internal"
        Title="{x:Static local:L.ReportWindowTitle}"
        Icon="pack://application:,,,/assets/BatteryBar.ico"
        Width="640" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="32,24,32,28">
        <TextBlock Text="{x:Static local:L.NotDetectedTitle}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" FontSize="13"
                   Text="{x:Static local:L.ReportIntro}" />

        <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.ReportDevice}" />
        <!-- Список с флажками: можно отметить сразу несколько устройств (например, мышь и её ресивер). -->
        <Border BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" local:SmoothScroll.IsEnabled="True">
                <StackPanel x:Name="DeviceChecks" Margin="12,6" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="ComboHint" Style="{StaticResource Secondary}" Margin="2,4,0,0" Text="{x:Static local:L.ReportSearching}" />

        <!-- Остальное появляется после выбора устройства. -->
        <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.ReportModel}" />
            <TextBox x:Name="ModelBox" TextChanged="Input_Changed" />
            <TextBlock Style="{StaticResource Secondary}" Margin="2,4,0,0" Text="{x:Static local:L.ReportModelHint}" />

            <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.ReportDetails}" />
            <TextBox x:Name="CommentBox" TextChanged="Input_Changed" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />
            <TextBlock Style="{StaticResource Secondary}" Margin="2,4,0,0"
                       Text="{x:Static local:L.ReportDetailsHint}" />

            <TextBlock Style="{StaticResource Label}" Text="{x:Static local:L.ReportPreview}" />
            <TextBox x:Name="PreviewBox" Height="200" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Content="{x:Static local:L.ReportCopy}" MinWidth="150" Margin="0,0,8,0" Click="Copy_Click" />
                <Button x:Name="SendButton" Grid.Column="2" Content="{x:Static local:L.ReportSend}" MinWidth="170" Click="Send_Click"
                        Style="{DynamicResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
