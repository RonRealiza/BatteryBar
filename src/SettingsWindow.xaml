<Window x:Class="BatteryBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BatteryBar"
        x:ClassModifier="internal"
        Title="{x:Static local:L.SettingsTitle}"
        Icon="pack://application:,,,/assets/BatteryBar.ico"
        Width="680" Height="760" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,24,0,8" />
        </Style>

        <Style x:Key="CardGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,18,0" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36">
            <TextBlock Text="BatteryBar" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" FontSize="13"
                       Text="{x:Static local:L.AppSubtitle}" />

            <!-- Устройства -->
            <TextBlock Text="{x:Static local:L.DevicesHeader}" Style="{StaticResource SectionHeader}" />
            <ItemsControl x:Name="DevicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CardGlyph}" Text="{Binding Glyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Status}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{Binding ChargeBrush}" Visibility="{Binding ChargeVisibility}" />
                                    <TextBlock Text="{Binding PercentText}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{Binding PercentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="NoDevicesCard" Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource Secondary}" FontSize="13"
                           Text="{x:Static local:L.NoDevices}" />
            </Border>
            <!-- Карточка-кнопка с мягким красноватым оттенком: выделяется, но не кричит. -->
            <Border Cursor="Hand" MouseLeftButtonUp="ReportDevice_Click">
                <Border.Resources>
                    <SolidColorBrush x:Key="ReportTint" Color="#E8505B" Opacity="0.10" />
                    <SolidColorBrush x:Key="ReportTintHover" Color="#E8505B" Opacity="0.18" />
                    <SolidColorBrush x:Key="ReportStroke" Color="#E8505B" Opacity="0.30" />
                </Border.Resources>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Background" Value="{DynamicResource ReportTint}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ReportStroke}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ReportTintHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE9CE;" Foreground="#E8707A" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:L.NotDetectedTitle}" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Text="{x:Static local:L.NotDetectedHint}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Отображение -->
            <TextBlock Text="{x:Static local:L.DisplayHeader}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE7F4;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:L.WhereTitle}" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Text="{x:Static local:L.WhereHint}" />
                    </StackPanel>
                    <ComboBox x:Name="DisplayCombo" Grid.Column="2" MinWidth="220" VerticalAlignment="Center"
                              SelectionChanged="DisplayCombo_SelectionChanged">
                        <ComboBoxItem Content="{x:Static local:L.WhereTaskbar}" />
                        <ComboBoxItem Content="{x:Static local:L.WhereTray}" />
                        <ComboBoxItem Content="{x:Static local:L.WhereBoth}" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border x:Name="MonitorsCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE7F9;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:L.MonitorsTitle}" />
                            <TextBlock Style="{StaticResource Secondary}"
                                       Text="{x:Static local:L.MonitorsHint}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="40,12,0,0">
                        <RadioButton x:Name="PrimaryRadio" GroupName="Monitors" Content="{x:Static local:L.MonitorsPrimary}" Margin="0,2"
                                     Checked="MonitorMode_Checked" />
                        <RadioButton x:Name="AllRadio" GroupName="Monitors" Content="{x:Static local:L.MonitorsAll}" Margin="0,2"
                                     Checked="MonitorMode_Checked" />
                        <RadioButton x:Name="SelectedRadio" GroupName="Monitors" Content="{x:Static local:L.MonitorsSelected}" Margin="0,2"
                                     Checked="MonitorMode_Checked" />
                        <StackPanel x:Name="MonitorChecks" Margin="28,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardGlyph}" Text="&#xF2B7;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:L.LanguageTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static local:L.LanguageHint}" />
                    </StackPanel>
                    <!-- Названия языков — на самих языках, чтобы их можно было найти при любом интерфейсе. -->
                    <ComboBox x:Name="LanguageCombo" Grid.Column="2" MinWidth="220" VerticalAlignment="Center"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="{x:Static local:L.LanguageAuto}" />
                        <ComboBoxItem Content="Русский" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Запуск -->
            <TextBlock Text="{x:Static local:L.StartupHeader}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE7E8;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:L.AutostartTitle}" />
                        <TextBlock x:Name="AutostartHint" Style="{StaticResource Secondary}"
                                   Text="{x:Static local:L.AutostartHint}" />
                    </StackPanel>
                    <CheckBox x:Name="AutostartCheck" Grid.Column="2" VerticalAlignment="Center"
                              Checked="AutostartCheck_Changed" Unchecked="AutostartCheck_Changed" />
                </Grid>
            </Border>

            <!-- Обслуживание -->
            <TextBlock Text="{x:Static local:L.MaintenanceHeader}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE72C;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:L.RefreshTitle}" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Text="{x:Static local:L.RefreshHint}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Static local:L.RefreshButton}" MinWidth="140" Click="Refresh_Click" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE8A5;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static local:L.LogTitle}" />
                        <TextBlock Style="{StaticResource Secondary}"
                                   Text="{x:Static local:L.LogHint}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{x:Static local:L.LogButton}" MinWidth="140" Click="OpenLog_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" Margin="2,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
