<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Нужен только ради UIAutomationClient (поиск кнопок на панели задач). -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>BatteryBar</RootNamespace>
    <AssemblyName>BatteryBar</AssemblyName>
    <Version>0.1.4</Version>
    <ApplicationIcon>assets\BatteryBar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконка окна настроек и трея; перерисовать — tools\make-icon.ps1. -->
    <Resource Include="assets\BatteryBar.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Силуэты геймпадов (SVG из редактора); разбирает DeviceIcons. -->
    <EmbeddedResource Include="assets\icons\*.svg" LogicalName="icons.%(Filename).svg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

</Project>
